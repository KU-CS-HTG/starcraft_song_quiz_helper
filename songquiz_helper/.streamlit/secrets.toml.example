# 로컬 테스트용 예시입니다.
# 이 파일을 secrets.toml 로 복사한 뒤 값을 채우세요. (secrets.toml 은 .gitignore 로 커밋되지 않습니다)
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# Streamlit Community Cloud 에서는 앱 설정 > Secrets 에 같은 형식으로 붙여넣습니다.

# 앱 접속 비밀번호 (내가 정하는 값)
APP_PASSWORD = "여기에-접속-비밀번호"

# YouTube Data API v3 키 (Google Cloud Console)
YOUTUBE_API_KEY = "AIza..."

# Anthropic API 키 (console.anthropic.com)
ANTHROPIC_API_KEY = "sk-ant-..."

# Supabase > Connect > Connection pooler (Transaction 또는 Session) URL
# 비밀번호에 특수문자(@ : / # 등)가 있으면 URL 인코딩(예: @ -> %40) 해야 합니다.
DATABASE_URL = "postgresql://postgres.xxxxxxxxxxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres"
